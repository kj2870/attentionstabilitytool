# Copy this file to .env and fill in your values.
# Local project path: C:\Users\kj287\Documents\01_Projects\focusflow
# GitHub repo: https://github.com/kj2870/attentionstabilitytool
# Get Supabase values from: https://app.supabase.com -> your project -> Settings -> API

VITE_APP_MODE=consumer
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — error tracking (production only). Get a DSN at sentry.io.
# Leave unset locally; Sentry stays dormant.
# VITE_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project

# Optional — usage analytics (production only). Get a project key at posthog.com.
# Leave unset locally; analytics stays dormant. Host defaults to US cloud.
# VITE_POSTHOG_KEY=phc_your_project_key
# VITE_POSTHOG_HOST=https://us.i.posthog.com
